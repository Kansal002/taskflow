# URL of the TaskFlow WebSocket sync server (apps/server).
#
# Leave EMPTY to run in local mode: boards persist to localStorage and sync
# live between tabs of the same browser via BroadcastChannel — no backend
# needed. This is how the static Netlify demo works out of the box.
#
# Set it to enable real multi-device collaboration, e.g.
#   VITE_WS_URL=ws://localhost:8787                      (local dev)
#   VITE_WS_URL=wss://taskflow-server.onrender.com       (production)
VITE_WS_URL=

{
  "name": "taskflow",
  "private": true,
  "version": "1.0.0",
  "description": "TaskFlow — a real-time collaborative Kanban board (React, TypeScript, WebSockets).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm run dev -w @taskflow/web",
    "dev:server": "npm run dev -w @taskflow/server",
    "build": "npm run build -w @taskflow/web && npm run build -w @taskflow/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke:ws": "node scripts/ws-smoke.mjs",
    "storybook": "npm run storybook -w @taskflow/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
